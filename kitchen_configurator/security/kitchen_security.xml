<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kitchen_design_rule_company" model="ir.rule">
        <field name="name">Kitchen 3D project: multi-company</field>
        <field name="model_id" ref="model_kitchen_design"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="kitchen_design_rule_salesman" model="ir.rule">
        <field name="name">Kitchen 3D project: own projects</field>
        <field name="model_id" ref="model_kitchen_design"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="kitchen_design_rule_all" model="ir.rule">
        <field name="name">Kitchen 3D project: all projects</field>
        <field name="model_id" ref="model_kitchen_design"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
    </record>

    <record id="kitchen_design_rule_portal" model="ir.rule">
        <field name="name">Kitchen 3D project: portal customers</field>
        <field name="model_id" ref="model_kitchen_design"/>
        <field name="domain_force">[('partner_id', 'child_of', [user.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
</odoo>
