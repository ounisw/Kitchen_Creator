<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="product_category_kitchen" model="product.category">
        <field name="name">Kitchen</field>
    </record>

    <!-- Used by portal quote requests for references that have no product yet. -->
    <record id="product_kitchen_item" model="product.product">
        <field name="name">Kitchen item</field>
        <field name="type">consu</field>
        <field name="sale_ok" eval="True"/>
        <field name="purchase_ok" eval="False"/>
        <field name="list_price">0.0</field>
        <field name="categ_id" ref="product_category_kitchen"/>
    </record>

    <record id="seq_kitchen_design" model="ir.sequence">
        <field name="name">Kitchen 3D project</field>
        <field name="code">kitchen.design</field>
        <field name="prefix">K3D/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
