<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_kitchen" model="ir.ui.view">
        <field name="name">product.template.form.kitchen</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="kitchen_ref"/>
            </field>
        </field>
    </record>

    <record id="product_template_search_view_kitchen" model="ir.ui.view">
        <field name="name">product.template.search.kitchen</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="kitchen_ref"/>
            </field>
            <filter name="filter_to_sell" position="after">
                <filter name="kitchen_configurator" string="Kitchen configurator" domain="[('kitchen_ref', '!=', False)]"/>
            </filter>
        </field>
    </record>
</odoo>
